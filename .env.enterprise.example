# 企业中间件连接配置（对接 docker-compose.enterprise.yml 或自建 NAS）
# 用法: 复制为 .env.local 并填入你的内网地址与密码，勿提交到 Git

# ── Redis（Phase 3 会话持久化）──
REDIS_URL=redis://YOUR_HOST:6379/0

# ── PostgreSQL + pgvector（Phase 4 向量库）──
DATABASE_URL=postgresql://kb:YOUR_PG_PASSWORD@YOUR_HOST:5433/enterprise_kb
VECTOR_STORE=pgvector

# ── Elasticsearch（Phase 2b 混合检索）──
ES_URL=http://YOUR_HOST:9200
ES_INDEX_PREFIX=enterprise_kb

# ── MinIO 对象存储（Phase 4 文件存储）──
S3_ENDPOINT=http://YOUR_HOST:9000
S3_ACCESS_KEY=kbadmin
S3_SECRET_KEY=YOUR_MINIO_PASSWORD
S3_BUCKET=enterprise-kb
STORAGE_BACKEND=s3

# ── 可选：ES 堆内存（低内存 NAS 建议 256m，≥16GB 可 512m）──
# ES_JAVA_OPTS=-Xms256m -Xmx256m

# ── 可选：PG 宿主机端口（compose 默认 5433，避免与系统 PG 5432 冲突）──
# POSTGRES_HOST_PORT=5433
