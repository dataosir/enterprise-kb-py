# ══════════════════════════════════════════════════════════════
# 企业知识库 — 统一配置文件
# 用法: cp .env.example .env  后按需修改（.env 勿提交 Git）
# ══════════════════════════════════════════════════════════════

# ── LLM / Embedding ──
DEEPSEEK_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_CHAT_MODEL=deepseek-chat

# DeepSeek 无 Embedding API，默认用本地中文向量模型（免费）
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com

# 若用 OpenAI 全家桶，改下面几项即可
# OPENAI_API_KEY=sk-your-key
# EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── RAG 参数（可调参实验，页面也可动态修改）──
RAG_TOP_K=4
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_FETCH_K=20
# RAG_SCORE_THRESHOLD=1.2
RAG_USE_MMR=false
RAG_MMR_LAMBDA=0.5
RAG_USE_RERANK=false
RAG_TEMPERATURE=0.2
RAG_HISTORY_TURNS=3
RAG_MAX_CONTEXT_CHARS=4000
RAG_SNIPPET_LENGTH=200
MAX_UPLOAD_SIZE_MB=20

# Phase 2b 混合检索（需启动 Elasticsearch，见下方企业中间件）
# RAG_RETRIEVAL_MODE=vector
# RAG_HYBRID_ALPHA=0.5
# RAG_RRF_K=60
# ES_INDEX_PREFIX=enterprise_kb

# ══════════════════════════════════════════════════════════════
# 企业中间件（可选，对接 docker-compose.enterprise.yml）
# 安装指南: docs/enterprise/MIDDLEWARE_SETUP.md
#
# 1. 取消下方 MIDDLEWARE_HOST 注释并填写地址（仅 IP/域名，不要加 http://）
# 2. 密码与 docker compose 共用，应用会自动拼接 REDIS_URL / DATABASE_URL 等
# 3. 启动中间件: docker compose -f docker-compose.enterprise.yml up -d
# ══════════════════════════════════════════════════════════════

# 正确: MIDDLEWARE_HOST=YOUR_HOST
# 错误: MIDDLEWARE_HOST=http://YOUR_HOST
# MIDDLEWARE_HOST=127.0.0.1

# ── PostgreSQL（应用 + docker compose 共用，生产环境请改密码）──
# 用户名 / 库名 / 端口见下方变量；密码请自行设置强密码
POSTGRES_USER=kb
POSTGRES_PASSWORD=changeme_pg_password
POSTGRES_DB=enterprise_kb
POSTGRES_HOST_PORT=5433
# 手动指定时用 postgresql://（不要用 jdbc:postgresql://，host 不要带 http://）
# DATABASE_URL=postgresql://kb:<YOUR_PASSWORD>@YOUR_HOST:5433/enterprise_kb

# ── MinIO / S3（应用 + docker compose 共用）──
# 用户名与密码请自行设置，勿使用默认值上线
MINIO_ROOT_USER=kbadmin
MINIO_ROOT_PASSWORD=changeme_minio_password

# ES 堆内存（低内存 NAS 建议 256m，≥16GB 可 512m）
ES_JAVA_OPTS=-Xms256m -Xmx256m

# 应用连接（留空则由 MIDDLEWARE_HOST + 上方账号自动拼接；也可手动覆盖单项）
# REDIS_URL=redis://127.0.0.1:6379/0
# ES_URL=http://127.0.0.1:9200
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY=kbadmin
# S3_SECRET_KEY=changeme_minio_password
# S3_BUCKET=enterprise-kb

# Phase 3 Redis 会话 + 异步入库（配置 MIDDLEWARE_HOST 或 REDIS_URL 后生效）
# CONVERSATION_STORE=auto
# CONVERSATION_TTL_SECONDS=604800
# ASYNC_INGEST=auto
# ASYNC_INGEST_THRESHOLD_MB=1
# JOB_TTL_SECONDS=86400

# Phase 4 向量库 / 文件存储（按需启用）
# VECTOR_STORE=pgvector
# STORAGE_BACKEND=s3

# Phase 5 认证与多租户（默认关闭，Demo 无鉴权）
AUTH_ENABLED=false
JWT_SECRET=changeme-jwt-secret
DEFAULT_TENANT=default
JWT_TTL_SECONDS=86400
