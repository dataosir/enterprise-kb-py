# DeepSeek（推荐，面试学习够用）
DEEPSEEK_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_CHAT_MODEL=deepseek-chat

# DeepSeek 无 Embedding API，默认用本地中文向量模型（免费）
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com

# 若用 OpenAI 全家桶，改下面两项即可
# OPENAI_API_KEY=sk-your-key
# EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RAG 参数（可调参实验，页面也可动态修改）
RAG_TOP_K=4
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_FETCH_K=20
# RAG_SCORE_THRESHOLD=1.2
RAG_USE_MMR=false
RAG_MMR_LAMBDA=0.5
RAG_USE_RERANK=false
RAG_TEMPERATURE=0.2
RAG_HISTORY_TURNS=3
RAG_MAX_CONTEXT_CHARS=4000
RAG_SNIPPET_LENGTH=200
# Phase 2b 混合检索（需配置 ES_URL，见 .env.enterprise.example）
# ES_URL=http://YOUR_HOST:9200
# ES_INDEX_PREFIX=enterprise_kb
# RAG_RETRIEVAL_MODE=vector
# RAG_HYBRID_ALPHA=0.5
# RAG_RRF_K=60
MAX_UPLOAD_SIZE_MB=20
